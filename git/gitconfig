  email = frankhjorth@gmail.com
  name = Frank Jensen

[github]
  user = fhmj

[init]
  defaultBranch = master

[core]
  editor = nvim
  autocrlf = false
  hooksPath = ./.githooks
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  line-numbers = true
  syntax-theme = Dracula
  plus-style = "syntax #2A363B"
  plus-emph-style = "syntax #2D4E45"
  minus-style = "syntax #3B2C37"
  minus-emph-style = "syntax #613038"
  navigate = true
  side-by-side = true

[diff]
  tool = vimdiff

[rerere]
  enabled = true

[rebase]
  autosquash = true

[merge]
  conflictstyle = diff3
  ff = false
  tool = nvimdiff

[mergetool]
  prompt = false
  keepBackup = false

[fetch]
  prune = true

[pull]
  rebase = false

[push]
  autoSetupRemote = true

[apply]
  whitespace = fix

[color]
  ui = auto

[color "decorate"]
  branch = green bold
  remoteBranch = red bold

[pretty]
	mylog = %C(red)%h%C(reset) -%C(auto)%d%C(reset) %s %C(blue)(%ad, %cn)%C(reset)

[alias]
  unstage = reset HEAD
  undo = reset --soft HEAD^

  a = add
  aa = add --all
  ap = add --patch
  au = add --update

  b = branch --sort=-committerdate --all --verbose
  bd = branch --delete
  bdd = branch --delete --force
  bm = branch --move
  bM = branch --move --force

  c = commit
  ca = commit --amend
  ci = commit --interactive
  cm = commit --message
  cv = commit --verbose

  d = diff
  ds = diff --staged

  o = checkout
  ob = checkout -b

  p = push

  l = log --graph --topo-order --abbrev-commit --date=relative --decorate --all --boundary --pretty=mylog
  lp = log --patch

  s = status --short --branch
  sa = status -s -uall

  st = stash list
  stu = stash -u
  stp = stash pop
  stdd = stash drop
