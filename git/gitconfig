[user]
  email = frankhjorth@gmail.com
  name = Frank Jensen

[github]
  user = fhmj

[init]
  defaultBranch = master

[core]
  editor = nvim
  autocrlf = false
  hooksPath = ./.githooks
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  line-numbers = true
  syntax-theme = Dracula
  plus-style = "syntax #2A363B"
  plus-emph-style = "syntax #2D4E45"
  minus-style = "syntax #3B2C37"
  minus-emph-style = "syntax #613038"
  navigate = true
  side-by-side = true

[diff]
  tool = vimdiff

[rerere]
  enabled = true

[rebase]
  autosquash = true

[merge]
  conflictstyle = diff3
  ff = false
  tool = nvimdiff

[mergetool]
  prompt = false
  keepBackup = false

[fetch]
  prune = true

[pull]
  rebase = false

[push]
  autoSetupRemote = true

[apply]
  whitespace = fix

[color]
  ui = auto

[color "decorate"]
  branch = green bold
  remoteBranch = red bold
