#!/usr/bin/env bash

# Require non-root sudo user
if [[ $EUID -eq 0 ]]; then
  echo "Please run this command as your normal user, not root (or sudo.)"
  exit 1
fi

DOTFILES=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)

# Create default directories
xdg-user-dirs-update

# Bash
ln -sf $DOTFILES/bash/.bashrc $HOME/.bashrc
ln -sf $DOTFILES/bash/.alias $HOME/.alias
ln -sf $DOTFILES/bash/.prompt $HOME/.prompt
ln -sf $DOTFILES/bash/.inputrc $HOME/.inputrc

# Git
ln -sf $DOTFILES/git/.gitconfig $HOME/.gitconfig

# Kitty
rm -rf $HOME/.config/kitty
ln -s $DOTFILES/kitty $HOME/.config/kitty

# Tmux
ln -sf $DOTFILES/tmux/tmux.conf $HOME/.tmux.conf

# SSH key
SSH_KEY="$HOME/.ssh/id_ed25519"
if [[ ! -f "$SSH_KEY" ]]; then
  read -rp "SSH key '$SSH_KEY' not found. Generate one now? [y/N]: " PROMPT </dev/tty
  if [[ "$PROMPT" =~ ^[yY]$ ]]; then
    mkdir -p $(dirname "$SSH_KEY")
    chmod 700 "$(dirname "$SSH_KEY")"
    ssh-keygen -t ed25519 -f "$SSH_KEY"
  fi
fi

# SSH agent
mkdir -p $HOME/.config/systemd/user
ln -sf $DOTFILES/systemd/ssh-agent.service $HOME/.config/systemd/user/ssh-agent.service
systemctl --user daemon-reload
systemctl --user enable --quiet --now ssh-agent.service

# Google Drive sync daemon
mkdir -p $HOME/.config/systemd/user
ln -sf $DOTFILES/systemd/gdrive-sync.service $HOME/.config/systemd/user/gdrive-sync.service
ln -sf $DOTFILES/systemd/gdrive-sync.timer $HOME/.config/systemd/user/gdrive-sync.timer
if rclone listremotes 2>/dev/null | grep -q '^gdrive:'; then
  systemctl --user daemon-reload
  systemctl --user enable --quiet --now gdrive-sync.timer
else
  echo "Failed to setup Google Drive sync. No 'gdrive' rclone remote found."
  echo "Please run gdrive-sync for first time setup, then re-run this command."
fi

# Custom functions
rm -rf $HOME/.local/bin
ln -s $DOTFILES/bin $HOME/.local/bin

# Hyprland
rm -rf $HOME/.config/hypr
ln -s $DOTFILES/hyprland $HOME/.config/hypr

# Prusa Slicer
rm -r $HOME/.config/PrusaSlicer/filament
rm -r $HOME/.config/PrusaSlicer/print
ln -s $DOTFILES/prusa-slicer/filament $HOME/.config/PrusaSlicer/filament
ln -s $DOTFILES/prusa-slicer/print $HOME/.config/PrusaSlicer/print

# Refresh config
source $HOME/.bashrc
