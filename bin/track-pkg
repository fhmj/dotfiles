#!/usr/bin/env bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACMAN_PACKAGES="$DOTFILES/packages.txt"
MARKER="# Auto-tracked (via track-pkg)"

[[ -f "$PACMAN_PACKAGES" ]] || exit 0
grep -qxF "$MARKER" "$PACMAN_PACKAGES" || printf '\n%s\n' "$MARKER" >> "$PACMAN_LIST"

while IFS= read -r pkg; do
  [[ -z "$pkg" ]] && continue
  pacman -Qi "$pkg" 2>/dev/null | grep -q "^Install Reason.*Explicitly installed" || continue
  grep -qxF "$pkg" "$PACMAN_PACKAGES" && continue
  echo "$pkg" >> "$PACMAN_PACKAGES"
done

if [[ -n "${SUDO_USER:-}" ]]; then
  chown "$SUDO_USER":"$SUDO_USER" "$PACMAN_PACKAGES" 2>/dev/null || true
fi
