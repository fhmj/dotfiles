#!/usr/bin/env bash
# Interactively find commits by source code additions/deletions (case-insensitive)
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Interactively find commits by source code additions/deletions (case-insensitive)."
  echo "Usage: git fci <path>..." >&2
  echo "" >&2
  echo "Examples:" >&2
  echo "  git fci src/index.php                 # History of a single file" >&2
  echo "  git fci src/Domain/                   # History of a whole directory" >&2
  echo "  git fci src/index.php src/Kernel.php  # History of multiple files" >&2
  exit 1
fi

git fc "$@" | \
  fzf --ansi \
  --header "Find commits by source code:" \
  --prompt "fci> " \
  --color=header:cyan:italic,prompt:yellow:italic \
  --no-sort \
  --reverse \
  --no-hscroll \
  --preview 'commit=$(echo {} | grep -Eo "[a-f0-9]{7,}" | head -1); git show --color=always $commit' \
  --preview-window=right:60%
