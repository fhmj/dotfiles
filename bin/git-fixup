#!/usr/bin/env bash
# Interactively create a fixup commit
set -euo pipefail

if [[ "${1:-}" == "-h" || $# -gt 1 ]]; then
  echo "Interactively create a fixup commit."
  echo "Usage: git fixup [commit-hash]" >&2
  echo "" >&2
  echo "Examples:" >&2
  echo "  git fixup            # Opens fzf to select the target commit interactively" >&2
  echo "  git fixup 1a2b3c4    # Creates a fixup for 1a2b3c4" >&2
  exit 1
fi

TARGET_COMMIT="${1:-}"

# If no argument was provided, open fzf to select the commit
if [ -z "$TARGET_COMMIT" ]; then
  PREVIEW_CMD='commit=$(echo {} | grep -Eo "[a-f0-9]{7,}" | head -1); git show --color=always --name-only $commit && echo && git show --format="" --color=always $commit'

  echo "Select the commit you want to fixup:" >&2

  TARGET_COMMIT=$(git log --topo-order --abbrev-commit --date=relative --decorate --graph --pretty=mylog --color=always | \
    fzf --ansi \
    --header "Fixup commit:" \
    --prompt "fixup> " \
    --color=header:cyan:italic,prompt:yellow:italic \
    --no-sort \
    --reverse \
    --no-hscroll \
    --preview "$PREVIEW_CMD" \
    --preview-window=right:60% | \
    grep -Eo '[a-f0-9]{7,}' | head -1 || true) # '|| true' to avoid errors in script if fzf aborts

  if [ -z "$TARGET_COMMIT" ]; then
    echo "Aborted." >&2
    exit 0
  fi
fi

echo "Creating fixup commit for $TARGET_COMMIT..."
git commit --fixup "$TARGET_COMMIT"
