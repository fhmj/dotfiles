#!/usr/bin/env bash
# Find commits by commit message
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Find commits by commit message."
  echo "Usage: git fm <search-string> [[--] <path>...]" >&2
  echo "" >&2
  echo "Examples:" >&2
  echo "  git fm \"fix bug\"                # Search all files" >&2
  echo "  git fm \"fix bug\" src/index.php  # Search only in src/index.php" >&2
  exit 1
fi

SEARCH_TERM="$1"
shift

git log --topo-order --abbrev-commit --date=relative --decorate --pretty=mylog --color=always \
  --grep="$SEARCH_TERM" -- "$@"
