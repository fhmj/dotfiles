#!/usr/bin/env bash
# List all git config aliases and custom script commands
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "List all git aliases and custom commands."
  echo "Usage: git aliases" >&2
  exit 0
fi

printf "\033[1;34mGit Config Aliases:\033[0m\n"

# Capture standard aliases, ignoring the error if none exist
if aliases=$(git config --get-regexp '^alias\.' 2>/dev/null); then
  echo "$aliases" | sed 's/^alias\.//' | while read -r line; do
  name="${line%% *}"  # Get everything before the first space
  cmd="${line#* }"    # Get everything after the first space
  printf "  \033[33m%-15s\033[0m %s\n" "$name" "$cmd"
done
else
  echo "  (No config aliases found)"
fi

echo ""
printf "\033[1;34mCustom Script Commands (~/.local/bin/git-*):\033[0m\n"

# Use nullglob so the array is empty if no files match (rather than containing the literal string)
shopt -s nullglob
scripts=(~/.local/bin/git-*)

if [ ${#scripts[@]} -eq 0 ]; then
  echo "  (No custom scripts found)"
else
  for file in "${scripts[@]}"; do
    # Ensure it is a file and executable
    if [[ -f "$file" && -x "$file" ]]; then
      basename="${file##*/}"
      name="${basename#git-}"

      # Read exactly line 2, strip the leading '#' and any spaces, and print
      desc=$(sed -n '2s/^#[[:space:]]*//p' "$file")

      # Fallback just in case line 2 isn't a comment
      if [[ -z "$desc" ]]; then
        desc="<no description found on line 2>"
      fi

      # Print custom scripts in green so they stand out from standard aliases
      printf "  \033[32m%-15s\033[0m %s\n" "$name" "$desc"
    fi
  done
fi
