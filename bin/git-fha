#!/usr/bin/env bash
# Show file history across all branches
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Show file history across all branches"
  echo "Usage: git fha <path>..." >&2
  echo "" >&2
  echo "Examples:" >&2
  echo "  git fha src/index.php                 # History of a single file" >&2
  echo "  git fha src/Domain/                   # History of a whole directory" >&2
  echo "  git fha src/index.php src/Kernel.php  # History of multiple files" >&2
  exit 1
fi

git log --all --graph --topo-order --abbrev-commit --date=relative --decorate --boundary \
  --pretty=mylog --color=always \
  -- "$1"
